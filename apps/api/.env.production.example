# ==============================================================================
# VorldX Attendance System - Production Environment Configuration (API Backend)
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production

# MongoDB Atlas Production Connection String
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/vorldx_attendance_prod?retryWrites=true&w=majority&appName=VorldXProd

# Cryptographic & Authentication Secrets
# Secure random 256-bit secret string (generate using `openssl rand -base64 32`)
JWT_SECRET=replace-with-a-cryptographically-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Allowed Client Origins (Comma-separated list of production URLs)
# Production frontends (the Express API also allows Vercel origins for REST).
CORS_ORIGIN=https://attendance-tracker-apps-kirtee.vercel.app,https://attendance-tracker-qq8u.vercel.app

# QR Code Cryptographic Settings
QR_ROTATION_SECONDS=30
QR_GRACE_SECONDS=15
DEFAULT_TIMEZONE=Asia/Kolkata

# Set a unique, high-entropy secret before running `npm run admin:setup`.
ADMIN_DEFAULT_PASSWORD=

# Brute-Force Rate Limiting & Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ==============================================================================
# Production OTP Mode Decision
# ==============================================================================
# Mobile employee activation OTP is delivered through configured Gmail SMTP.
# OTP codes are never returned by the mobile registration API.
DEMO_OTP_MODE=false
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Brevo transactional email for signup verification and HR invitations.
# Verify the sender address/domain in Brevo before sending production mail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VORLDX Employee Attendance System

# Gmail SMTP for mobile employee activation OTP via Nodemailer.
# Port 587 with SMTP_SECURE=false uses STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Gmail account address.
SMTP_USER=
# Google-generated 16-character App Password, never the normal Gmail password.
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VORLDX INDUSTRIES PRIVATE LIMITED

