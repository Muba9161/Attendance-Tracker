PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/vorldx_attendance
JWT_SECRET=demo-secret-key-at-least-32-chars-long-vorldx
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081
QR_ROTATION_SECONDS=30
QR_GRACE_SECONDS=15
DEFAULT_TIMEZONE=Asia/Kolkata
# Set a unique secret before running `npm run admin:setup`.
ADMIN_DEFAULT_PASSWORD=
EMPLOYEE_DEFAULT_PASSWORD=Employee@2026!
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
DEMO_OTP_MODE=true
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Brevo transactional email for employee signup OTP verification
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VORLDX Employee Attendance System

# Gmail SMTP for mobile employee activation OTP via Nodemailer.
# Port 587 with SMTP_SECURE=false uses STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Gmail account address.
SMTP_USER=
# Google-generated 16-character App Password, never the normal Gmail password.
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VORLDX INDUSTRIES PRIVATE LIMITED

