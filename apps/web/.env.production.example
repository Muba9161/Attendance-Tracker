# Public URL of the deployed Express + Socket.io backend API
# Required for hosted/external browser builds. Vercel's SPA rewrite does not proxy API requests.
# Set this to the public backend domain (e.g. https://api.vorldx.yourdomain.com).
VITE_API_URL=https://api.vorldx.yourdomain.com

