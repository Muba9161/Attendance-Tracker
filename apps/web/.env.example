# Optional: omit locally to use the Vite /api and /socket.io proxy.
# Required for external/hosted builds; set to that environment's API origin.
VITE_API_URL=
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Optional development-only login helpers. Set true and provide local demo
# credentials explicitly; do not add privileged credentials to production env.
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_HR_EMAIL=
VITE_DEMO_HR_PASSWORD=

